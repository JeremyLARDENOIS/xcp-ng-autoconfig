[Unit]
Description=Private XCP-ng host address
Requires=xapi.service
After=xapi.service iptables.service ip6tables.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/xcpng-private-net {{ bootstrap_host_address }} {{ https_forward_address | default('') }}
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target

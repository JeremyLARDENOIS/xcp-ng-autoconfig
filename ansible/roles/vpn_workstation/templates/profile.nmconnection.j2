[connection]
id={{ vpn_profile }}
uuid={{ vpn_uuid }}
type=wireguard
interface-name={{ vpn_profile }}
autoconnect=true

[wireguard]
private-key={{ lookup('ansible.builtin.file', playbook_dir ~ '/../../private/wireguard/admin.key') | trim }}
peer-routes=true

[wireguard-peer.{{ lookup('ansible.builtin.file', playbook_dir ~ '/../../private/wireguard/sites/' ~ inventory_hostname ~ '.pub') | trim }}]
endpoint={{ admin_vpn.endpoint }}:51821
allowed-ips={{ vpn_destinations | join(';') }};
persistent-keepalive=25

[ipv4]
method=manual
address1={{ admin_vpn.client_address }}
never-default=true
ignore-auto-dns=true

[ipv6]
method=disabled
